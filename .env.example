# =====================================================================
# Configuración Proyecto Malla Vial Bogotá - Scraping Twitter y Comentarios
# =====================================================================

# Llave de API de Scrapfly (se detecta automáticamente si está en Windows User Environment)
SCRAPFLY_KEY=
SCRAPFLY_API_KEY=

# Límite máximo de seguridad de créditos de Scrapfly por ejecución
SCRAPFLY_MAX_CREDITOS=50

# Rutas a los archivos JSON de cookies exportadas de cuentas verificadas
TWITTER_COOKIES_FILE_1=conversaciones/twitter_cookies_cuenta_1.json
TWITTER_COOKIES_FILE_2=conversaciones/twitter_cookies_cuenta_2.json

# Cookies activas de Cuenta 1
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Cookies de Cuenta 2 (de respaldo o rotación)
TWITTER_AUTH_TOKEN_CUENTA_2=
TWITTER_CT0_CUENTA_2=

# Configuración de Comentarios y Percepción Ciudadana
EXTRAER_COMENTARIOS_HILOS=true
MAX_TWEETS_CON_COMENTARIOS=15
